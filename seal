#!/usr/bin/env bash
set -euo pipefail

# seal - Sync live config back into the repo
# Usage:
#   ./seal              Seal quickshell only
#   ./seal hypr         Seal hyprland only
#   ./seal fish         Seal fish only
#   ./seal kitty        Seal kitty only
#   ./seal hypr kitty   Seal multiple targets
#   ./seal all          Seal everything

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$SCRIPT_DIR")"
REPO_DOTS="$REPO_ROOT/dots/.config"
TARGETS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    all)        TARGETS=(quickshell hypr fish kitty); shift ;;
    hypr)       TARGETS+=(hypr); shift ;;
    fish)       TARGETS+=(fish); shift ;;
    kitty)      TARGETS+=(kitty); shift ;;
    quickshell) TARGETS+=(quickshell); shift ;;
    -h|--help)
      echo "Usage: $(basename "$0") [target ...]"
      echo "  (no args)    Seal quickshell only"
      echo "  all          Seal quickshell + hyprland + fish + kitty"
      echo "  hypr         Seal hyprland config"
      echo "  fish         Seal fish config"
      echo "  kitty        Seal kitty config"
      echo "  quickshell   Seal quickshell config"
      echo "Targets can be combined: $(basename "$0") hypr fish"
      exit 0 ;;
    *) echo "Unknown target: $1"; exit 1 ;;
  esac
done

# Default to quickshell if no targets specified
if [[ ${#TARGETS[@]} -eq 0 ]]; then
  TARGETS=(quickshell)
fi

seal_config() {
  local name="$1"
  local live="$HOME/.config/$name"
  local repo="$REPO_DOTS/$name"

  if [[ ! -d "$live" ]]; then
    echo "SKIP: $live not found"
    return 0
  fi

  echo "Sealing $name..."
  mkdir -p "$repo"
  rsync -a --delete \
    --exclude='.git' \
    --exclude='.gitmodules' \
    "$live/" \
    "$repo/"

  # Clean nested git artifacts
  find "$repo" -name .git -type d -prune -exec rm -rf {} +
  find "$repo" -name .git -type f -delete
  find "$repo" -name .gitmodules -type f -delete
}

cd "$REPO_ROOT"

# --- Seal ---
for target in "${TARGETS[@]}"; do
  seal_config "$target"
done

# --- Status ---
echo ""
echo "Changes:"
STATUS_PATHS=()
for target in "${TARGETS[@]}"; do
  STATUS_PATHS+=("dots/.config/$target")
done
git status --short "${STATUS_PATHS[@]}"

echo ""
echo "Seal complete."
