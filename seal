#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/Desktop/dots-hyprland"
LIVE="$HOME/.config/quickshell"
REPO_QS="$REPO/dots/.config/quickshell"
BRANCH="runeforge"

echo "== Seal ritual initiated =="

if [ ! -d "$REPO/.git" ]; then
  echo "ERROR: The archive could not be found:"
  echo "$REPO"
  exit 1
fi

if [ ! -d "$LIVE" ]; then
  echo "ERROR: live quickshell config not found:"
  echo "$LIVE"
  exit 1
fi

mkdir -p "$REPO_QS"

cd "$REPO"

echo "Inspecting active branch..."
if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git checkout "$BRANCH"
else
  git checkout -b "$BRANCH"
fi

echo "Inscribing live shell state into repository..."
rsync -a --delete \
  --exclude='.git' \
  --exclude='.gitmodules' \
  "$LIVE/" \
  "$REPO_QS/"

echo "Purging foreign Git relics..."
find "$REPO_QS" -name .git -type d -prune -exec rm -rf {} +
find "$REPO_QS" -name .git -type f -delete
find "$REPO_QS" -name .gitmodules -type f -delete

echo "Current archive changes:"
git status --short dots/.config/quickshell

if git diff --quiet -- dots/.config/quickshell && git diff --cached --quiet -- dots/.config/quickshell; then
  echo "The seal remains unchanged."
  exit 0
fi

echo "Seal complete. The current shell state has been preserved."
