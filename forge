#!/usr/bin/env bash
set -euo pipefail

# forge - Reforge the shell from the sealed Runeforge branch
# Modes:
#   all         - Full system reforging ritual
#   quickshell  - Reforge Quickshell and awaken sealed shell state

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$SCRIPT_DIR")"
BRANCH="runeforge"
QS_CONFIG="ii"
QS_LIVE="$HOME/.config/quickshell"
QS_REPO="$REPO_ROOT/dots/.config/quickshell"
QS_PKGBUILD="$REPO_ROOT/sdata/dist-arch/illogical-impulse-quickshell-git"

# Fork-specific packages (not in upstream)
FORK_PACKAGES=(
  awww
)

MODE=""
NO_PULL=false

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RST='\033[0m'

usage() {
  cat <<EOF
Usage: $(basename "$0") [MODE] [OPTIONS]

Rituals:
  all           Full system reforging ritual
  quickshell    Reforge Quickshell + awaken sealed shell state

Options:
  --no-pull     Skip drawing latest runes from origin
  -h, --help    Show this help

Examples:
  $(basename "$0") all
  $(basename "$0") quickshell
  $(basename "$0") quickshell --no-pull
EOF
}

log() { printf "${GREEN}==>${RST} ${BOLD}%s${RST}\n" "$*"; }
warn() { printf "${RED}==>${RST} ${BOLD}%s${RST}\n" "$*"; }
info() { printf "${CYAN}  ->${RST} %s\n" "$*"; }

ensure_branch() {
  local current
  current="$(git -C "$REPO_ROOT" branch --show-current)"
  if [[ "$current" != "$BRANCH" ]]; then
    log "Channeling branch $BRANCH..."
    git -C "$REPO_ROOT" checkout "$BRANCH"
  fi
}

pull_latest() {
  if $NO_PULL; then return 0; fi
  log "Drawing latest runes from origin..."
  git -C "$REPO_ROOT" pull origin "$BRANCH" || warn "Rune retrieval failed — proceeding with local branch"
}

init_submodules() {
  log "Synchronizing bound relics..."
  git -C "$REPO_ROOT" submodule update --init --recursive
}

rebuild_quickshell() {
  if ! command -v makepkg &>/dev/null; then
    warn "The forge requires Arch Linux tools. makepkg is missing."
    return 1
  fi

  if [[ ! -f "$QS_PKGBUILD/PKGBUILD" ]]; then
    warn "The forge blueprint could not be found:"
    warn "$QS_PKGBUILD/PKGBUILD"
    return 1
  fi

  log "Reforging Quickshell from sacred blueprint..."
  pushd "$QS_PKGBUILD" >/dev/null

  source ./PKGBUILD

  if command -v yay &>/dev/null; then
    log "Summoning build dependencies..."
    yay -S --sudoloop --needed --asdeps "${depends[@]}"
  else
    warn "Dependency familiar 'yay' was not found. Install build deps manually if needed."
  fi

  makepkg -Afsi --noconfirm

  popd >/dev/null
  info "Quickshell has been successfully reforged"
}

backup_quickshell() {
  if [[ ! -d "$QS_LIVE" ]]; then return 0; fi

  local backup_dir="$HOME/.config/quickshell.backup.$(date +%F-%H%M%S)"

  log "Preserving current shell state..."
  info "$QS_LIVE → $backup_dir"

  cp -a "$QS_LIVE" "$backup_dir"
}

sync_quickshell() {
  if [[ ! -d "$QS_REPO" ]]; then
    warn "No sealed Quickshell state was found:"
    warn "$QS_REPO"
    exit 1
  fi

  log "Awakening sealed shell state..."

  mkdir -p "$QS_LIVE"

  rsync -a --delete \
    --exclude='.git' \
    --exclude='.gitmodules' \
    "$QS_REPO/" \
    "$QS_LIVE/"

  info "Live shell state awakened at $QS_LIVE"
}

restart_quickshell() {
  log "Reigniting Quickshell..."

  killall qs quickshell 2>/dev/null || true
  sleep 0.5

  qs -c "$QS_CONFIG" &
  disown

  info "The shell has awakened"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  all | quickshell)
    MODE="$1"
    shift
    ;;
  --no-pull)
    NO_PULL=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    warn "Unknown rune: $1"
    usage
    exit 1
    ;;
  esac
done

if [[ -z "$MODE" ]]; then
  echo ""
  printf "${BOLD}Choose a forging ritual:${RST}\n"
  echo "  1) all          - Full system reforging ritual"
  echo "  2) quickshell   - Reforge and awaken Quickshell"
  echo ""
  printf "${CYAN}:: ${RST}Select ritual [1/2]: "

  read -r choice

  case "$choice" in
  1 | all)
    MODE="all"
    ;;
  2 | quickshell | qs)
    MODE="quickshell"
    ;;
  *)
    warn "Invalid ritual"
    exit 1
    ;;
  esac
fi

log "Invoked ritual: $MODE"
info "Archive: $REPO_ROOT"
info "Branch:  $BRANCH"

ensure_branch
pull_latest
init_submodules

case "$MODE" in
all)
  log "Beginning full system reforging..."
  cd "$REPO_ROOT"
  ./setup install
  if [[ ${#FORK_PACKAGES[@]} -gt 0 ]]; then
    log "Installing fork packages..."
    sudo pacman -S --needed --noconfirm "${FORK_PACKAGES[@]}"
  fi
  ;;
quickshell)
  rebuild_quickshell
  backup_quickshell
  sync_quickshell
  restart_quickshell
  ;;
esac

log "Ritual complete."
