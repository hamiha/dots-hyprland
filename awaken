#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/Desktop/dots-hyprland"
REPO_QS="$REPO/dots/.config/quickshell"
LIVE="$HOME/.config/quickshell"
BACKUP="$HOME/.config/quickshell.backup.$(date +%F-%H%M%S)"
BRANCH="runeforge"

echo "== Awakening archived shell state =="

if [ ! -d "$REPO/.git" ]; then
  echo "ERROR: The archive could not be found:"
  echo "$REPO"
  exit 1
fi

if [ ! -d "$REPO_QS" ]; then
  echo "ERROR: No sealed Quickshell state was found:"
  echo "$REPO_QS"
  exit 1
fi

cd "$REPO"

echo "Channeling branch: $BRANCH"
git checkout "$BRANCH"

echo "Preserving current shell state at:"
echo "$BACKUP"
cp -a "$LIVE" "$BACKUP"

echo "Awakening sealed shell state into the live environment..."
rsync -a --delete \
  --exclude='.git' \
  --exclude='.gitmodules' \
  "$REPO_QS/" \
  "$LIVE/"

echo "Awakening complete. The live shell now reflects the sealed state."
