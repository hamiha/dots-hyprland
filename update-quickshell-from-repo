#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/Desktop/dots-hyprland"
REPO_QS="$REPO/dots/.config/quickshell"
LIVE="$HOME/.config/quickshell"
BACKUP="$HOME/.config/quickshell.backup.$(date +%F-%H%M%S)"
BRANCH="my-quickshell"

echo "== Update live Quickshell from repo =="

if [ ! -d "$REPO/.git" ]; then
  echo "ERROR: repo not found or not a Git repo:"
  echo "$REPO"
  exit 1
fi

if [ ! -d "$REPO_QS" ]; then
  echo "ERROR: repo quickshell config not found:"
  echo "$REPO_QS"
  exit 1
fi

cd "$REPO"

echo "Switching to branch: $BRANCH"
git checkout "$BRANCH"

echo "Backing up current live config to:"
echo "$BACKUP"
cp -a "$LIVE" "$BACKUP"

echo "Syncing repo config into live config..."
rsync -a --delete \
  --exclude='.git' \
  --exclude='.gitmodules' \
  "$REPO_QS/" \
  "$LIVE/"

echo "Done. Live Quickshell updated from repo."
